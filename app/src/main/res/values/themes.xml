<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OzelTelefon" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF2F2F7</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Arama ekranı: siyah zemin, kayma yok, sadece solma (fade) geçişi -->
    <style name="InCallWindowAnim" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/hold</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:taskOpenExitAnimation">@anim/hold</item>
        <item name="android:taskCloseEnterAnimation">@anim/hold</item>
        <item name="android:taskCloseExitAnimation">@anim/fade_out</item>
        <item name="android:taskToFrontEnterAnimation">@anim/fade_in</item>
        <item name="android:taskToFrontExitAnimation">@anim/hold</item>
        <item name="android:taskToBackEnterAnimation">@anim/hold</item>
        <item name="android:taskToBackExitAnimation">@anim/fade_out</item>
    </style>

    <style name="Theme.OzelTelefon.InCall" parent="Theme.OzelTelefon">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@style/InCallWindowAnim</item>
    </style>
</resources>
